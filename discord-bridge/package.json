{
  "name": "roz-discord-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Puente roz ↔ Discord: mantiene la conexión al gateway, espeja el servidor de Discord en Supabase (schema roz) y avisa a roz para el tiempo real. Corre en Railway.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "sync-shared": "node scripts/sync-shared.mjs",
    "register-commands": "tsx --env-file-if-exists=.env src/register-commands.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
