{
  "name": "roz",
  "version": "0.1.0",
  "description": "zeus — el back de roz: API, MCP, planificador, gateway de Discord y gestión de contexto en un proceso (Hono + Supabase). El front vive en web/.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "mcp:stdio": "node dist/mcp/stdio.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict false",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:run": "vitest run",
    "discord:commands": "tsx scripts/discord-commands.ts",
    "discord:emojis": "tsx scripts/discord-emojis.ts"
  },
  "keywords": [
    "roz",
    "mcp",
    "context",
    "routing"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "openai": "^4.67.0",
    "pino": "^9.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.7.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
