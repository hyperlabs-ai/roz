# roz — environment configuration
# Copy to `.env` and fill in. See docs/GITHUB-SETUP.md and the Self-hosting section
# of the README for how to obtain each value.
#
# In production (ROZ_ENV=production) the variables marked [required in prod] must be
# set or the server fails fast on boot.

# ── Runtime ───────────────────────────────────────────────────────────────────
ROZ_ENV=development            # development | production
ROZ_LOG_LEVEL=info
PORT=3000                      # local dev only

# ── Supabase (Postgres + pgvector; schema `roz` must be exposed in API settings) ─
SUPABASE_URL=                  # [required in prod] https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # [required in prod] server-side only, never shipped to the client
SUPABASE_ANON_KEY=             # [required in prod] used only to validate the dashboard user's JWT

# ── Dashboard ───────────────────────────────────────────────────────────────────
# Comma-separated email domains allowed to sign in to the dashboard. Empty = nobody
# passes the domain filter in prod (set your own, e.g. acme.com,acme.io).
DASHBOARD_ALLOWED_DOMAINS=
# Public URL of the dashboard, used in digest/alert email buttons (e.g. https://roz.acme.com).
DASHBOARD_URL=

# ── Anthropic (Claude — reasoning, classification, semantic dedup) ───────────────
ANTHROPIC_API_KEY=             # [required in prod]
ROZ_CLAUDE_MODEL=claude-haiku-4-5

# ── TypeSafe (Jev — task classification for automatic assignment, optional) ──────
# Empty key = automatic assignment off (intake keeps the embedding router). Get a key at
# https://console.typesafe.ai/keys. The model is pinned: thresholds are tuned against a version.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_BASE_URL=https://api.typesafe.ai
ROZ_AUTO_ASSIGN=true           # kill switch: false turns automatic assignment off even with a key

# ── Linear (roz v2: Linear como fuente de verdad de las tareas) ─────────────────
# Con ROZ_LINEAR_SOT=true roz deja de crear/editar tareas: /ticket, intake y las juntas
# crean el issue en Linear y work_item pasa a ser un espejo de solo lectura (webhook +
# reconciliación cada 30 min). Con el flag en false (default) roz se comporta como antes.
# Si el flag está encendido, LINEAR_API_KEY y LINEAR_WEBHOOK_SECRET son obligatorios.
LINEAR_API_KEY=                # Personal API key (Settings → Security & access → API keys)
LINEAR_WEBHOOK_SECRET=         # signing secret del webhook (Settings → API → Webhooks) → POST /webhooks/linear
LINEAR_TEAM_ID=                # equipo por defecto para proyectos sin linear_team_id (opcional)
ROZ_LINEAR_SOT=false

# ── Discord (el chat de roz sobre el servidor real de la empresa) ────────────────
# Con ROZ_DISCORD_CHAT=true el chat de roz muestra los canales REALES del servidor
# de Discord (leer y escribir en tiempo real); con false (default) el chat interno
# queda exactamente como antes. Contrato: docs/discord-chat-contracts.md.
# Si el flag está encendido, todo lo de abajo (salvo los opcionales) es obligatorio,
# y también ROZ_ENCRYPTION_KEY (los tokens de webhook se guardan cifrados).
#
# Setup en https://discord.com/developers/applications (una vez):
#   1. Crear la app → Bot: copiar el token; activar los intents privilegiados
#      SERVER MEMBERS y MESSAGE CONTENT.
#   2. Invitar el bot al servidor con permisos: View Channels, Read Message History,
#      Send Messages, Send Messages in Threads, Manage Webhooks, Embed Links,
#      Attach Files.
#   3. OAuth2 → Redirects: registrar EXACTAMENTE DISCORD_OAUTH_REDIRECT_URI:
#        http://localhost:3000/api/discord/callback
#        https://<tu-dominio>/api/discord/callback
# El puente (discord-bridge/, Railway) usa el MISMO DISCORD_BOT_TOKEN,
# DISCORD_GUILD_ID y ROZ_BRIDGE_SECRET, más SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY.
DISCORD_BOT_TOKEN=             # nunca se loguea
DISCORD_GUILD_ID=              # id del servidor (Modo desarrollador → clic derecho → Copiar ID)
DISCORD_CLIENT_ID=             # OAuth2 → Client ID
DISCORD_CLIENT_SECRET=         # OAuth2 → Client Secret
DISCORD_OAUTH_REDIRECT_URI=    # debe calzar carácter por carácter con la registrada en Discord
DISCORD_API_URL=https://discord.com/api/v10   # opcional; solo se cambia en pruebas
DISCORD_MAX_UPLOAD_BYTES=10485760             # opcional; 10 MiB sin boost
# Secreto compartido puente → roz. Generar una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROZ_BRIDGE_SECRET=
ROZ_DISCORD_CHAT=false

# ── Granola (juntas por API, opcional) ───────────────────────────────────────────
# Sin llave el poll (cada 5 min) queda apagado y las juntas se suben a mano.
GRANOLA_API_KEY=

# ── OpenAI (embeddings for the second brain) ────────────────────────────────────
OPENAI_API_KEY=
ROZ_EMBEDDING_MODEL=text-embedding-3-large
ROZ_EMBEDDING_DIM=3072

# ── GitHub (read-only: commits, PRs, repos). See docs/GITHUB-SETUP.md ───────────
GITHUB_TOKEN=                  # fine-grained PAT: Contents read, Metadata read, Pull requests read
GITHUB_WEBHOOK_SECRET=         # [required in prod] HMAC secret shared with the GitHub webhook

# ── Email (Resend) ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=roz <onboarding@resend.dev>

# ── HyperOps fallback (optional, HyperLabs-internal) ────────────────────────────
# When false (default), roz resolves repo→project only via the direct roz.project_repo
# mapping + manual projects, and never reads a `public` schema. Leave false for self-host.
HYPEROPS_FALLBACK=false

# ── Infrastructure observability (all optional; degrade gracefully if unset) ─────
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
RAILWAY_API_TOKEN=
SUPABASE_ACCESS_TOKEN=         # Supabase Management API personal access token

# ── Service tokens ──────────────────────────────────────────────────────────────
ROZ_MCP_TOKEN=                 # [required in prod] bearer for the MCP surface (Claude)
ROZ_INGEST_TOKEN=              # [required in prod] bearer for POST /v1/intake (client apps)
CRON_SECRET=                   # [required in prod] bearer Vercel Cron injects; without it crons 403

# ── Weekly digest ───────────────────────────────────────────────────────────────
# Comma-separated recipients of the team digest. Empty = team digest not sent.
DIGEST_RECIPIENTS=

# ── Web Push (PWA notifications) ─────────────────────────────────────────────────
# Push notifications to the installed PWA — fires for the same infra warnings as email.
# Optional: without VAPID keys, push degrades silently. Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=              # exposed to the browser (safe to be public)
VAPID_PRIVATE_KEY=            # server-only secret — never expose to the client
VAPID_SUBJECT=mailto:roz@hyperdigital.mx   # contact (mailto: or https URL) required by the spec

# ── Google Calendar (presencia en vivo: "ocupado hasta las 11:30") ────────────────
# Cada dev conecta SU propia cuenta desde Configuración; roz solo LEE eventos
# (scope calendar.readonly). Opcional: sin client id/secret la feature se
# apaga en silencio. Si defines uno, los cuatro de abajo son obligatorios.
#
# Setup en Google Cloud Console (una vez):
#   1. Crear proyecto y habilitar la Google Calendar API.
#   2. Pantalla de consentimiento: elegir "Internal" si tu dominio es Google
#      Workspace — calendar.events.readonly es un scope sensible y en modo
#      "External" obliga a test users y a verificación de Google.
#   3. Credentials → OAuth client ID → Web application, y registrar como redirect
#      URIs autorizadas EXACTAMENTE las mismas que pongas en GOOGLE_REDIRECT_URI:
#        http://localhost:3000/api/calendar/callback
#        https://<tu-dominio>/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=          # debe calzar carácter por carácter con la registrada en Google

# Cifrado de los tokens de terceros guardados por dev (AES-256-GCM). Sin esto los
# refresh tokens quedarían en claro en la base, así que el server se niega a
# arrancar con Google configurado y esta llave vacía. Generar una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROZ_ENCRYPTION_KEY=           # 32 bytes en base64
